      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "advanced_machine_features": [],
            "can_ip_forward": false,
            "confidential_instance_config": null,
            "creation_timestamp": "2026-05-27T17:00:50.787-07:00",
            "deletion_policy": "DELETE",
